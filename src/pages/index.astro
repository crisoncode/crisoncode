---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Card from "@components/Card";
import Hero from "@components/Hero.astro";
import getSortedPosts from "@utils/getSortedPosts";
import slugify from "@utils/slugify";
import { getReadingTime } from "@utils/getReadingTime";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
---

<Layout>
	<Header />
	<main id="main-content">
		<Hero />

		<div id="recent-posts">
			<div class="section-header">
				<span class="section-label">$ ls -la posts/ | head -4</span>
				<a href="/posts" class="all-posts-link">ls -la posts/ →</a>
			</div>

			<div class="ls-col-headers">
				<span>permissions</span>
				<span class="right"></span>
				<span class="right">size</span>
				<span>modified</span>
				<span>filename</span>
			</div>

			<div class="ls-divider"></div>

			<ul class="ls-post-list">
				{
					sortedPosts.map(
						(post, index) =>
							index < 4 && (
								<Card
									href={`/posts/${slugify(post.data)}`}
									frontmatter={post.data}
									secHeading={false}
									readingTime={getReadingTime(post.body)}
								/>
							)
					)
				}
			</ul>
		</div>
	</main>

	<Footer />
</Layout>

<style>
	@reference "../styles/base.css";

	main {
		max-width: 900px;
		margin: 0 auto;
		padding: 36px 20px 60px;
	}

	#recent-posts {
		margin-top: 0;
	}

	.section-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 6px;
	}

	.section-label {
		font-size: 14px;
		color: rgb(var(--color-accent));
		font-family: "IBM Plex Mono", monospace;
	}

	.all-posts-link {
		font-size: 14px;
		color: rgba(var(--color-text-base), 0.45);
		text-decoration: none;
		font-family: "IBM Plex Mono", monospace;
		transition: color 0.12s;
	}

	.all-posts-link:hover {
		color: rgb(var(--color-accent));
	}

	.ls-divider {
		border-top: 1px solid rgb(var(--color-border));
		margin-bottom: 4px;
	}
</style>
