---
import { SITE } from "@config";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
---

<Layout title={`404 Not Found | ${SITE.title}`}>
	<Header />

	<main id="main-content">
		<div class="not-found-wrapper">
			<h1 aria-label="404 Not Found">404</h1>
			<span class="shrug" aria-hidden="true">¯\_(ツ)_/¯</span>
			<p>This page doesn't exist</p>
			<p class="subtext">
				The link may be broken or the page may have been removed.
			</p>
			<LinkButton
				href="/"
				className="my-6 text-lg underline decoration-dashed underline-offset-8 transition-transform hover:-translate-y-0.5"
			>
				Back to home
			</LinkButton>
		</div>
	</main>

	<Footer />
</Layout>

<style>
	@reference "../styles/base.css";
	#main-content {
		@apply mx-auto flex max-w-3xl flex-1 items-center justify-center;
	}
	.not-found-wrapper {
		@apply mb-14 flex flex-col items-center justify-center;
	}
	.not-found-wrapper h1 {
		@apply text-skin-accent text-9xl font-bold;
		animation: float 3s ease-in-out infinite;
	}
	.not-found-wrapper .shrug {
		@apply mt-2 text-4xl sm:text-5xl;
		display: inline-block;
		animation: shrug 2s ease-in-out infinite;
		animation-delay: 0.5s;
	}
	.not-found-wrapper p {
		@apply mt-4 text-2xl sm:text-3xl;
	}
	.not-found-wrapper .subtext {
		@apply text-skin-base-70 mt-2 text-base sm:text-lg;
	}

	@keyframes float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-8px);
		}
	}

	@keyframes shrug {
		0%,
		100% {
			transform: rotate(0deg);
		}
		25% {
			transform: rotate(-3deg);
		}
		75% {
			transform: rotate(3deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.not-found-wrapper h1,
		.not-found-wrapper .shrug {
			animation: none;
		}
	}
</style>
