---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Tag from "@components/Tag.astro";
import Datetime from "@components/Datetime";
import type { CollectionEntry } from "astro:content";
import { getReadingTime } from "@utils/getReadingTime";
import { getCollection } from "astro:content";

export interface Props {
	post: CollectionEntry<"blog">;
}

const { post } = Astro.props;

const { title, author, description, ogImage, pubDatetime, tags } = post.data;

const { Content } = await post.render();

const readingTime = getReadingTime(post.body);

const ogUrl = new URL(ogImage ? ogImage : `${title}.svg`, Astro.url.origin)
	.href;

// Get all posts to find the next one
const allPosts = await getCollection("blog");
const sortedPosts = allPosts.sort(
	(a, b) => new Date(b.data.pubDatetime).getTime() - new Date(a.data.pubDatetime).getTime()
);
const currentIndex = sortedPosts.findIndex((p) => p.slug === post.slug);
const nextPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;
---

<Layout title={title} author={author} description={description} ogImage={ogUrl}>
	<div id="reading-progress" style="
		position: fixed;
		top: 52px;
		left: 0;
		height: 2px;
		background: rgb(var(--color-accent));
		width: 0%;
		transition: width 0.1s linear;
		z-index: 50;
	"></div>
	<Header />
	<div class="mx-auto flex w-full max-w-5xl justify-start px-4">
		<button
			class="focus-outline mt-8 mb-2 flex hover:opacity-75"
			onclick="history.back()"
		>
			<svg xmlns="http://www.w3.org/2000/svg"
				><path
					d="M13.293 6.293 7.586 12l5.707 5.707 1.414-1.414L10.414 12l4.293-4.293z"
				></path>
			</svg><span>Go back</span>
		</button>
	</div>
	<main id="main-content">
		<article id="article" role="article" class="article-container">
			<p class="breadcrumb">
				<a href="/posts">posts/</a> › {post.slug}
			</p>
			<h1 class="post-title">{title}</h1>
			<p class="post-meta">
				<Datetime
					datetime={pubDatetime}
					size="lg"
					className=""
					readingTime={readingTime}
				/> · {tags.length > 0 && tags.join(", ")}
			</p>
			<div class="post-divider"></div>
			<div class="prose">
				<Content />
			</div>
		</article>

		<nav class="post-nav">
			<a href="/posts" class="post-nav-btn">← all posts</a>
			{nextPost && <a href={`/posts/${nextPost.slug}`} class="post-nav-btn">next →</a>}
		</nav>

		<ul class="tags-container">
			{tags.map(tag => <Tag name={tag} />)}
		</ul>
	</main>
	<Footer />
</Layout>

<style>
	@reference "../styles/base.css";
	main {
		@apply mx-auto w-full max-w-5xl px-4 pb-12;
	}

	.article-container {
		max-width: 720px;
		margin: 0 auto;
	}

	.breadcrumb {
		font-size: 11px;
		color: rgb(var(--color-text-base));
		opacity: 0.45;
		margin-bottom: 16px;
	}

	.breadcrumb a {
		color: rgb(var(--color-accent));
		text-decoration: none;
	}

	.breadcrumb a:hover {
		text-decoration: underline;
	}

	.post-title {
		font-size: 26px;
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.3;
		color: rgb(var(--color-text-base));
		margin: 0;
	}

	.post-meta {
		font-size: 11px;
		color: rgb(var(--color-text-base));
		opacity: 0.45;
		margin-top: 12px;
		margin-bottom: 0;
	}

	.post-divider {
		border-bottom: 1px solid rgb(var(--color-border));
		margin: 24px 0 32px 0;
	}

	.prose {
		margin-top: 0;
	}

	.prose p {
		font-size: 14px;
		line-height: 1.8;
		color: rgb(var(--color-text-base));
		margin-bottom: 14px;
	}

	.prose h2 {
		font-size: 18px;
		font-weight: 600;
		letter-spacing: -0.02em;
		border-bottom: 1px solid rgb(var(--color-border));
		margin-top: 40px;
		padding-bottom: 8px;
		color: rgb(var(--color-text-base));
	}

	.prose h3 {
		font-size: 15px;
		font-weight: 600;
		color: rgb(var(--color-accent));
		margin-top: 28px;
	}

	.prose blockquote {
		border-left: 3px solid rgb(var(--color-secondary));
		background: rgba(var(--color-secondary), 0.05);
		border-radius: 0 4px 4px 0;
		padding: 12px 16px;
		font-style: italic;
		margin: 0;
	}

	.prose ul {
		list-style: none;
		padding: 0;
	}

	.prose ul li {
		list-style: none;
		padding-left: 18px;
		position: relative;
		margin-bottom: 8px;
	}

	.prose ul li::before {
		content: '›';
		position: absolute;
		left: 0;
		color: rgb(var(--color-accent));
	}

	.prose pre,
	.prose pre code {
		background: #0d1117;
		border: 1px solid rgb(var(--color-border));
		border-radius: 5px;
		padding: 16px 18px;
		font-size: 12px;
		overflow-x: auto;
		margin-bottom: 14px;
	}

	.prose :not(pre) > code {
		background: rgba(var(--color-accent), 0.1);
		border: 1px solid rgba(var(--color-accent), 0.2);
		border-radius: 3px;
		padding: 1px 5px;
		color: rgb(var(--color-accent));
		font-size: 0.9em;
	}

	.post-nav {
		display: flex;
		justify-content: space-between;
		margin-top: 48px;
		padding-top: 24px;
		border-top: 1px solid rgb(var(--color-border));
		max-width: 720px;
		margin-left: auto;
		margin-right: auto;
	}

	.post-nav-btn {
		border: 1px solid rgb(var(--color-border));
		border-radius: 3px;
		padding: 6px 12px;
		font-size: 12px;
		font-family: 'IBM Plex Mono', monospace;
		color: rgb(var(--color-text-base));
		opacity: 0.45;
		text-decoration: none;
		transition: all 0.15s;
	}

	.post-nav-btn:hover {
		border-color: rgb(var(--color-accent));
		color: rgb(var(--color-accent));
		opacity: 1;
	}

	.tags-container {
		@apply my-10 flex flex-wrap gap-2;
	}
	.prose .grid {
		display: grid !important;
		grid-template-columns: 1fr;
		gap: 2rem;
		margin: 2rem 0;
		align-items: start;
	}
	@media (min-width: 768px) {
		.prose .grid {
			grid-template-columns: 1fr 1fr !important;
		}
	}
	.prose .grid > div:first-child {
		position: sticky;
		top: 2rem;
	}
	.prose .grid img {
		width: 100%;
		height: auto;
		border-radius: 0.5rem;
	}
</style>

<script>
	const bar = document.getElementById('reading-progress');
	const article = document.querySelector('article') || document.querySelector('main');

	function updateProgress() {
		const scrollTop = window.scrollY;
		const docHeight = article.scrollHeight - window.innerHeight;
		const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
		bar.style.width = Math.min(progress, 100) + '%';
	}

	window.addEventListener('scroll', updateProgress, { passive: true });
	updateProgress();
</script>
