---
import { SITE } from "@config";

const currentPath = new URL(Astro.request.url).pathname;

const navItems = [
	{ label: "home", href: "/" },
	{ label: "posts", href: "/posts" },
	{ label: "tags", href: "/tags" },
	{ label: "about", href: "/about" },
];
---

<a id="skip-to-content" href="#main-content">Skip to content</a>

<header>
	<div class="header-inner">
		<a href="/" class="logo">
			<span class="prefix">> </span>
			<span class="brand">#CrisOnCode</span>
		</a>

		<nav>
			<ul>
				{
					navItems.map(item => (
						<li>
							<a
								href={item.href}
								class={`nav-link ${currentPath === item.href ? "active" : ""}`}
							>
								{item.label}
							</a>
						</li>
					))
				}
				{
					SITE.lightAndDarkMode && (
						<li>
							<button
								id="theme-btn"
								class="nav-link theme-btn"
								title="Toggle theme"
								aria-label="Toggle theme"
								aria-live="polite"
							>
								<span id="theme-icon">◑</span>
							</button>
						</li>
					)
				}
			</ul>
		</nav>
	</div>
</header>

<style>
	#skip-to-content {
		position: absolute;
		top: -9999px;
		left: 0;
		z-index: 999;
		padding: 0.5rem 1rem;
		background: rgb(var(--color-accent));
		color: rgb(var(--color-fill));
		border-radius: 3px;
	}

	#skip-to-content:focus {
		top: 1rem;
		left: 1rem;
	}

	header {
		position: sticky;
		top: 0;
		z-index: 100;
		height: 52px;
		background: rgb(var(--color-fill));
		backdrop-filter: blur(10px);
		border-bottom: 1px solid rgb(var(--color-border));
	}

	.header-inner {
		max-width: 860px;
		margin: 0 auto;
		padding: 0 20px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 52px;
	}

	.logo {
		display: flex;
		align-items: center;
		gap: 0;
		text-decoration: none;
		border: none;
		font-size: 15px;
		font-weight: 600;
		font-family: "IBM Plex Mono", monospace;
		transition: opacity 0.15s;
	}

	.logo:hover {
		opacity: 0.8;
	}

	.logo .prefix {
		color: rgb(var(--color-text-base));
		opacity: 0.5;
	}

	.logo .brand {
		color: rgb(var(--color-accent));
	}

	nav ul {
		display: flex;
		align-items: center;
		gap: 0;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	nav ul li {
		display: flex;
		align-items: center;
	}

	.nav-link {
		font-size: 12px;
		font-weight: 500;
		padding: 4px 10px;
		border-radius: 3px;
		color: rgba(var(--color-text-base), 0.6);
		border: 1px solid transparent;
		background: transparent;
		cursor: pointer;
		font-family: inherit;
		transition: all 0.15s;
		text-decoration: none;
		display: block;
	}

	.nav-link:hover {
		color: rgb(var(--color-text-base));
		border: 1px solid rgb(var(--color-border));
	}

	.nav-link.active {
		color: rgb(var(--color-accent));
		border: 1px solid rgb(var(--color-accent));
		background: rgba(var(--color-accent), 0.15);
	}

	.theme-btn {
		margin-left: 4px;
	}

	.theme-btn:hover {
		color: rgb(var(--color-accent));
		border: 1px solid rgb(var(--color-accent));
	}
</style>

<script>
	// Sync icon with current theme — toggle-theme.js handles the click
	const themeIcon = document.getElementById("theme-icon");

	function updateThemeIcon() {
		const theme =
			document.documentElement.getAttribute("data-theme") ||
			localStorage.getItem("theme") ||
			"light";
		if (themeIcon) {
			themeIcon.textContent = theme === "dark" ? "◑" : "○";
		}
	}

	updateThemeIcon();

	// Watch for data-theme attribute changes driven by toggle-theme.js
	new MutationObserver(updateThemeIcon).observe(document.documentElement, {
		attributes: true,
		attributeFilter: ["data-theme"],
	});
</script>
